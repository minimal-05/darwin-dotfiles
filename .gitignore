# secrets — gh stores an OAuth token in hosts.yml
gh/
*.token
*_token
.DS_Store

# editor / tool state, not config
nvim/lazy-lock.json
**/*.log
__pycache__/
*.pyc

# app state written by the Eden launcher, not config
eden/

# backup litter — git is the backup now
*.bak
*.bak.*
*.backup
*-bash.bak/
*.orig
*.bak-*
*.quickshell-version

# Karabiner writes a dated copy of karabiner.json on every save
karabiner/automatic_backups/
