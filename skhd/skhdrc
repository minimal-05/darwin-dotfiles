# for any chord skhd holds here, so only bind in one place.
ctrl + alt + cmd - e        : ~/Projects/quickshell-macos/bin/qs-finder
ctrl + alt + cmd - y        : ~/Projects/quickshell-macos/bin/qs-toggle
# study tracker (levels, heatmap, badges)
ctrl + alt + cmd - s        : ~/Projects/quickshell-macos/bin/qs ipc call studyMode tracker
