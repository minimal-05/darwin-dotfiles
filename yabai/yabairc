#!/usr/bin/env sh

# The scripting addition is what lets yabai focus a Space. Loading it needs
# root, and this script runs from launchd with no terminal, so -n makes a
# missing sudoers rule fail fast instead of hanging on a password prompt.
# Grant it once with:  sudo visudo -f /etc/sudoers.d/yabai
#   <user> ALL=(root) NOPASSWD: /opt/homebrew/bin/yabai --load-sa
sudo -n yabai --load-sa 2>/dev/null || echo "yabai: scripting addition not loaded (see /etc/sudoers.d/yabai)" >&2
yabai -m signal --add event=dock_did_restart action="sudo -n yabai --load-sa"

# The shell's own signals (quickshell-macos/bin/qs-yabai-signals): a yabai
# restart drops every signal, and the shell has no event telling it so. This
# script does know, so it re-registers them; the path is absolute for the
# same reason skhdrc's and karabiner.json's qs-ipc calls are.
[ -x "$HOME/Projects/quickshell-macos/bin/qs-yabai-signals" ] && "$HOME/Projects/quickshell-macos/bin/qs-yabai-signals" install

yabai -m config mouse_follows_focus off \
  focus_follows_mouse autofocus \
  window_zoom_persist off \
  window_placement second_child \
  window_shadow float \
  window_opacity off \
  window_opacity_duration 0.2 \
  active_window_opacity 1.0 \
  normal_window_opacity 0.8 \
  insert_feedback_color 0xff9dd274 \
  split_ratio 0.50 \
  mouse_modifier fn \
  mouse_action1 move \
  mouse_action2 resize \
  mouse_drop_action swap \
  external_bar all:40:0 \
  top_padding 0 \
  bottom_padding 8 \
  left_padding 8 \
  right_padding 8 \
  window_gap 8

# Exclude problematic apps from being managed:
yabai -m rule --add app="^(LuLu|Calculator|Autodesk Fusion|Fusion|Software Update|Exam.net|Dictionary|VLC|System Preferences|System Settings|zoom.us|Photo Booth|Archive Utility|Python|LibreOffice|App Store|Steam|Alfred|Activity Monitor|Simulator|Tailscale|Karabiner-Elements)$" manage=off
yabai -m rule --add label="Finder" app="^Finder$" title="(Co(py|nnect)|Move|Info|Pref)" manage=off
yabai -m rule --add label="Safari" app="^Safari$" title="^(General|(Tab|Password|Website|Extension)s|AutoFill|Se(arch|curity)|Privacy|Advance)$" manage=off
yabai -m rule --add label="About This Mac" app="System Information" title="About This Mac" manage=off
yabai -m rule --add label="Select file to save to" app="^Inkscape$" title="Select file to save to" manage=off
yabai -m config layout bsp
yabai -m rule --apply
